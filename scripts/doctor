#!/usr/bin/env bash
#
# doctor: compare the running machine against what the repository declares.
#
#   scripts/doctor <full-target>
#   just doctor
#
# READ-ONLY. It changes nothing; it prints one line per check, "ok" or
# "fail", and exits with the number of failures. Where inventory answers
# "what should be here", doctor answers "is it actually here, and is there
# anything here that should not be".
#
# What it checks:
#   - the target matches this machine's CPU and OS
#   - every command the modules install is on PATH
#   - Home Manager's profile and the config symlinks it manages exist
#   - Neovim's Lua parses and its language servers are present
#   - workstation only: the desktop tools, keyd's installed copies match the
#     repository, the GPU rule is in place
#   - Fedora: every package in platform/fedora/packages is installed, and
#     nothing was hand-installed with dnf outside that list (drift)
#   - macOS: the Brewfile is fully installed and brew has nothing extra (drift)
#   - files Home Manager pushed aside on a machine that already had an
#     environment (*.pre-home-manager) that have not been reconciled yet
#
# Drift is reported, never fixed: add the package to the manifest or remove
# it yourself.

# -u: unset variables are errors. -o pipefail: a pipeline fails if any command
# in it fails. NOT -e: a failing check must be recorded and the script must
# continue to the next one.
set -uo pipefail

target="${1:-}"
repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# Three outcomes per check:
#   ok    as declared
#   fail  broken or missing; the machine does not match the repository
#   look  nothing is broken, but a human should look (leftover backups)
failures=0
looks=0
checks=0

if [[ -z "$target" ]]; then
  printf 'Usage: doctor <full-target>\n' >&2
  exit 2
fi

pass() {
  ((checks += 1))
  printf 'ok   %s\n' "$1"
}

fail() {
  ((checks += 1))
  ((failures += 1))
  printf 'fail %s\n' "$1" >&2
}

look() {
  ((checks += 1))
  ((looks += 1))
  printf 'look %s\n' "$1" >&2
}

check_command() {
  if command -v "$1" >/dev/null 2>&1; then
    pass "$1 is available"
  else
    fail "$1 is unavailable"
  fi
}

# Print a manifest file (platform/fedora/packages, platform/fedora/baseline)
# with comment lines and blank lines removed, one entry per line. An entry
# is a package name or the URL of an rpm; URLs are reduced to the package
# name so the rest of the script only ever sees names:
#   rustdesk-1.4.9-0.x86_64.rpm -> rustdesk   (strip .rpm, the arch, then -version)
#   chatgpt.x86_64.rpm          -> chatgpt    (no version in the file name)
manifest() {
  local line name
  while read -r line; do
    name="$line"
    if [[ "$line" == http* ]]; then
      name="$(basename "$line")"
      name="${name%.rpm}"
      name="${name%.x86_64}"; name="${name%.aarch64}"; name="${name%.noarch}"
      name="${name%%-[0-9]*}"
    fi
    printf '%s\n' "$name"
  done < <(grep -v -E '^[[:space:]]*(#|$)' "$1" || true)
}

# Drift check for dnf. Two directions:
#   missing  a name in platform/fedora/packages that rpm does not know about
#   orphan   a package dnf recorded as installed by a person (reason "User")
#            that is in neither packages nor baseline
# Orphans are reported, never removed: add them to a manifest or run
# `sudo dnf remove` yourself. Skipped silently on non-dnf systems.
check_dnf_drift() {
  command -v dnf >/dev/null 2>&1 || return 0

  local packages_file="$repo_dir/platform/fedora/packages"
  local baseline_file="$repo_dir/platform/fedora/baseline"
  local name

  while read -r name; do
    if rpm -q "$name" >/dev/null 2>&1; then
      pass "dnf package $name is installed"
    else
      fail "dnf package $name is missing (run: just bootstrap $target)"
    fi
  done < <(manifest "$packages_file")

  # `comm -23 A B` prints lines only in A. Both inputs must be sorted.
  # A = packages dnf marks as user-installed on this machine.
  # B = everything the repository knows about (packages + baseline).
  local orphans
  orphans="$(comm -23 \
    <(dnf repoquery --installed --qf '%{name} %{reason}\n' 2>/dev/null |
      awk '$2 == "User" { print $1 }' | sort -u) \
    <(cat <(manifest "$packages_file") <(manifest "$baseline_file") | sort -u))"

  if [[ -z "$orphans" ]]; then
    pass "no dnf packages installed outside platform/fedora/packages"
  else
    fail "dnf packages installed by hand but not in platform/fedora/packages or baseline:"
    # Print each orphan on its own indented line under the failure message.
    while read -r name; do printf '       %s\n' "$name" >&2; done <<<"$orphans"
  fi
}

# Drift check for Homebrew, same two directions using brew's own tooling:
#   `brew bundle check`   exits non-zero if the Brewfile is not fully installed
#   `brew bundle cleanup` WITHOUT --force only prints what it would uninstall,
#                         i.e. everything brew has that the Brewfile does not
check_brew_drift() {
  command -v brew >/dev/null 2>&1 || return 0

  local brewfile="$repo_dir/platform/darwin/Brewfile"
  local name

  if brew bundle check --file "$brewfile" >/dev/null 2>&1; then
    pass "Brewfile is fully installed"
  else
    fail "Brewfile has missing entries (run: just bootstrap $target)"
  fi

  local orphans
  orphans="$(brew bundle cleanup --file "$brewfile" 2>/dev/null || true)"
  if [[ -z "$orphans" ]]; then
    pass "no Homebrew packages installed outside the Brewfile"
  else
    fail "Homebrew packages installed by hand but not in the Brewfile:"
    # Print each orphan on its own indented line under the failure message.
    while read -r name; do printf '       %s\n' "$name" >&2; done <<<"$orphans"
  fi
}

case "$(uname -m)" in
  x86_64|amd64) architecture="x86_64" ;;
  arm64|aarch64) architecture="aarch64" ;;
  *) architecture="unsupported" ;;
esac

case "$(uname -s)" in
  Linux) kernel="linux" ;;
  Darwin) kernel="darwin" ;;
  *) kernel="unsupported" ;;
esac

system="${architecture}-${kernel}"
if [[ "$target" == *"-${system}" ]]; then
  pass "target matches $system"
else
  fail "target $target does not match $system"
fi

# Every command the target's modules register in custom.smoke (each module
# declares its own; see home/common.nix). Asked of the flake so this list
# can never drift from what is installed. If one is missing here, a module
# was removed from the target, the apply failed, or PATH is wrong.
mapfile -t commands < <(
  nix --extra-experimental-features 'nix-command flakes' eval --raw --no-warn-dirty \
    "path:$repo_dir#homeConfigurations.\"$target\".config.custom.smoke" \
    --apply 's: builtins.concatStringsSep "\n" (builtins.attrNames s)' 2>/dev/null
)
if ((${#commands[@]} == 0)); then
  fail "could not read the command list from the flake"
fi
for command in "${commands[@]}"; do
  check_command "$command"
done

# Flakes and the `nix <verb>` CLI must be on for every just recipe to work.
# bootstrap writes this to /etc/nix/nix.conf (Fedora's package ships it);
# `nix config show` prints the merged, effective settings.
if nix config show 2>/dev/null | grep -E '^experimental-features' | grep -q 'flakes'; then
  pass "flakes are enabled in the effective nix config"
else
  fail "flakes are not enabled (bootstrap writes experimental-features to /etc/nix/nix.conf)"
fi

profile="$HOME/.local/state/nix/profiles/home-manager"
if [[ -e "$profile" || -L "$profile" ]]; then
  pass "Home Manager profile exists"
else
  fail "Home Manager profile is missing"
fi

case "$target" in
  workstation-*-linux)
    check_command bash
    check_command rustdesk # from RustDesk's rpm, so not in custom.smoke
    # Electron apps: their --version needs a display, so they are not in
    # custom.smoke; only presence is checked.
    check_command spotify
    check_command slack
    check_command discord
    check_command obsidian
    check_command chatgpt # OpenAI's rpm
    check_command mullvad # Mullvad's package; the daemon is mullvad-daemon

    check_dnf_drift

    # The laptop is an SSH destination too (`ssh t14s` from the others);
    # the Fedora bootstrap enables the service.
    if systemctl is-active --quiet sshd; then
      pass "sshd is running"
    else
      fail "sshd is not running (run: just bootstrap)"
    fi

    ghostty_config="$HOME/.config/ghostty/config"
    if [[ -L "$ghostty_config" && -e "$ghostty_config" ]]; then
      pass "Ghostty configuration symlink is valid"
    else
      fail "Ghostty configuration symlink is invalid"
    fi

    if command -v keyd >/dev/null 2>&1 &&
      keyd check "$repo_dir/platform/fedora/keyd/default.conf" >/dev/null 2>&1
    then
      pass "keyd configuration is valid"
    else
      fail "keyd configuration is invalid"
    fi

    if command -v systemctl >/dev/null 2>&1 && systemctl is-active --quiet keyd.service; then
      pass "keyd service is active"
    else
      fail "keyd service is inactive"
    fi

    # The copies platform/fedora/bootstrap.sh placed under /etc and /usr/local
    # must match what Home Manager and the repository currently have; if not,
    # a keyd update or config edit has not been applied with a bootstrap run.
    if cmp -s "$HOME/.nix-profile/bin/keyd" /usr/local/bin/keyd-nix; then
      pass "installed keyd binary matches Home Manager"
    else
      fail "installed keyd binary is stale"
    fi

    if cmp -s "$repo_dir/platform/fedora/keyd/default.conf" /etc/keyd/default.conf; then
      pass "installed keyd configuration matches repository"
    else
      fail "installed keyd configuration is stale"
    fi

    if cmp -s "$repo_dir/platform/fedora/keyd/keyd.service" /etc/systemd/system/keyd.service; then
      pass "installed keyd service matches repository"
    else
      fail "installed keyd service is stale"
    fi

    # Battery charge limit: the installed rule must match the repository, and
    # on a machine with a battery the firmware must currently hold the values
    # the rule sets. A mismatch means the rule has not been applied yet
    # (run bootstrap) or something else changed the thresholds.
    if cmp -s "$repo_dir/platform/fedora/battery.conf" /etc/tmpfiles.d/environment-battery.conf; then
      pass "installed battery charge-limit rule matches repository"
    else
      fail "installed battery charge-limit rule is stale or missing"
    fi
    if [[ -r /sys/class/power_supply/BAT0/charge_control_end_threshold ]]; then
      want_end="$(awk '/charge_control_end_threshold/ {print $NF}' "$repo_dir/platform/fedora/battery.conf")"
      want_start="$(awk '/charge_control_start_threshold/ {print $NF}' "$repo_dir/platform/fedora/battery.conf")"
      have_end="$(cat /sys/class/power_supply/BAT0/charge_control_end_threshold)"
      have_start="$(cat /sys/class/power_supply/BAT0/charge_control_start_threshold)"
      if [[ "$have_end" == "$want_end" && "$have_start" == "$want_start" ]]; then
        pass "battery charges to $have_end% (resumes below $have_start%)"
      else
        fail "battery thresholds are $have_start/$have_end%, rule says $want_start/$want_end%"
      fi
    fi

    # /etc/tmpfiles.d/non-nixos-gpu.conf must point at the rule inside the
    # current Home Manager generation, otherwise /run/opengl-driver is stale
    # and Ghostty (Nix-built) cannot find the GPU.
    gpu_setup="$HOME/.nix-profile/bin/non-nixos-gpu-setup"
    gpu_root="$(dirname "$(dirname "$(readlink -f "$gpu_setup")")")"
    expected_gpu_conf="$gpu_root/lib/tmpfiles.d/non-nixos-gpu.conf"
    if [[ "$(readlink -f /etc/tmpfiles.d/non-nixos-gpu.conf)" == "$expected_gpu_conf" ]]; then
      pass "non-NixOS GPU integration matches Home Manager"
    else
      fail "non-NixOS GPU integration is stale or missing"
    fi


    ;;
  workstation-*-darwin)
    check_command zsh
    check_command brew
    check_command ghostty # from Homebrew, so not in custom.smoke

    if [[ -d /Applications/RustDesk.app ]]; then
      pass "RustDesk application is installed"
    else
      fail "RustDesk application is missing"
    fi

    if [[ -d /Applications/Tailscale.app ]]; then
      pass "Tailscale application is installed"
    else
      fail "Tailscale application is missing"
    fi

    check_brew_drift

    ghostty_config="$HOME/.config/ghostty/config"
    if [[ -L "$ghostty_config" && -e "$ghostty_config" ]]; then
      pass "Ghostty configuration symlink is valid"
    else
      fail "Ghostty configuration symlink is invalid"
    fi
    ;;
  server-*-linux)
    check_command bash
    # platform/debian/packages, on a Debian/Ubuntu server: each listed
    # package must be installed. (`dpkg -s` exits non-zero if not.)
    if command -v dpkg >/dev/null 2>&1; then
      while read -r name; do
        if dpkg -s "$name" >/dev/null 2>&1; then
          pass "apt package $name is installed"
        else
          fail "apt package $name is missing (run: just bootstrap $target)"
        fi
      done < <(manifest "$repo_dir/platform/debian/packages")
    fi
    ;;
  *)
    fail "unknown target $target"
    ;;
esac

# Tailscale: installed by the OS (platform/), so the checks are about the
# machine's state, not the generation. Three stages, and the last is a
# `look`: logging in is a one-time interactive step with your account
# (`sudo tailscale up`), so "not logged in" is a reminder, not breakage.
#   tailscale status  exits non-zero and prints "Logged out." until the
#                     machine has joined the tailnet
if command -v tailscale >/dev/null 2>&1; then
  if [[ "$(uname -s)" == Linux ]]; then
    if systemctl is-active --quiet tailscaled; then
      pass "tailscaled is running"
    else
      fail "tailscaled is not running (run: just bootstrap)"
    fi
  fi
  if tailscale status >/dev/null 2>&1; then
    pass "tailscale is logged in ($(tailscale status --self --peers=false 2>/dev/null | awk 'NR==1{print $2}'))"
  else
    look "tailscale is installed but this machine has not joined the tailnet; once: sudo tailscale up"
  fi
fi

# Runtimes that a manager downloads.
#
# Why these checks exist: Rust and Python are not installed by Nix here. Nix
# installs the MANAGER (rustup, uv; home/dev/), and the manager downloads the
# actual toolchain or interpreter into the home directory the first time it
# is asked (`rustup default stable`, `uv python install`). Until that has
# happened on a machine, `cargo`, `rustc`, and `python` are either missing
# or are stubs that fail with a confusing error. Nothing is broken, it is a
# one-time step not yet done, so these are `look`s rather than `fail`s, and
# each says the command to run.
#
# How each check works:
#   rustup show active-toolchain   exits non-zero until a toolchain is
#                                  installed and selected as the default
#   uv python list --only-installed  lists interpreters uv has downloaded;
#                                    empty output means none yet
if command -v rustup >/dev/null 2>&1; then
  if rustup show active-toolchain >/dev/null 2>&1; then
    pass "rust toolchain is installed ($(rustup show active-toolchain 2>/dev/null | awk '{print $1}'))"
  else
    look "no rust toolchain installed yet; once per machine: rustup default stable"
  fi
fi
if command -v uv >/dev/null 2>&1; then
  if uv python list --only-installed 2>/dev/null | grep -q .; then
    pass "python is installed via uv ($(uv python list --only-installed 2>/dev/null | head -1 | awk '{print $1}'))"
  else
    look "no python installed yet; once per machine: uv python install"
  fi
fi

# Backups from taking over a machine that already had an environment.
#
# When Home Manager wants to place a file where one already exists (a
# hand-written ~/.bashrc, a Stow symlink), it does not merge and does not
# silently overwrite: bootstrap passes `-b pre-home-manager`, so the
# original is renamed to <file>.pre-home-manager and the managed file takes
# its place. Nothing is lost, but nothing from the old file is carried over
# either. This check stays red until each backup has been looked at:
# move anything worth keeping into the repository, then delete the backup.
mapfile -t backups < <(find "$HOME" -maxdepth 3 -name '*.pre-home-manager' -not -path "$HOME/.cache/*" 2>/dev/null | sort)
if ((${#backups[@]} == 0)); then
  pass "no pre-home-manager backups waiting to be reconciled"
else
  look "${#backups[@]} backup(s) from before Home Manager took over; have a look, then delete them"
  {
    printf '\n'
    printf '     When Home Manager first ran here it found these files already in place and\n'
    printf '     kept them as backups. Usually they are the stock ones the OS ships and\n'
    printf '     everything in them is already in the repository. To see what differs:\n\n'
    for backup in "${backups[@]}"; do
      managed="${backup%.pre-home-manager}"
      printf '       diff %s %s\n' "${backup/#"$HOME"/\~}" "${managed/#"$HOME"/\~}"
    done
    printf '\n     If nothing in them matters (or once you have moved what does into the\n'
    printf '     repository), delete them and this goes away:\n\n'
    printf '       rm'
    for backup in "${backups[@]}"; do printf ' %s' "${backup/#"$HOME"/\~}"; done
    printf '\n       just sync\n\n'
  } >&2
fi

# Home Manager manages these as symlinks into the Nix store. A regular file
# here means something overwrote the symlink; a dangling one means the
# generation it pointed at was garbage-collected.
tmux_config="$HOME/.config/tmux/tmux.conf"
if [[ -L "$tmux_config" && -e "$tmux_config" ]]; then
  pass "tmux configuration symlink is valid"
else
  fail "tmux configuration symlink is invalid"
fi

nvim_config="$HOME/.config/nvim/init.lua"
if [[ -L "$nvim_config" && -e "$nvim_config" ]]; then
  pass "Neovim configuration symlink is valid"
else
  fail "Neovim configuration symlink is invalid"
fi

# Two Neovim checks in one headless run (Neovim started with no UI, runs
# the Lua below, quits):
#   1. every Lua file under the config parses (a syntax error would
#      otherwise break Neovim's next start)
#   2. every external program the config expects is on Neovim's PATH; Nix
#      puts them there via home/neovim/default.nix.
# The list comes from the flake (custom.neovimTools, declared in
# home/neovim/default.nix next to the packages that provide it), so it
# cannot drift from what is installed.
mapfile -t nvim_tools < <(
  nix --extra-experimental-features 'nix-command flakes' eval --raw --no-warn-dirty \
    "path:$repo_dir#homeConfigurations.\"$target\".config.custom.neovimTools" \
    --apply 'xs: builtins.concatStringsSep "\n" xs' 2>/dev/null
)
if ((${#nvim_tools[@]} == 0)); then
  fail "could not read Neovim's tool list from the flake"
fi
# Turn the bash array into the Lua list literal {"git","curl",...}.
nvim_tools_lua="$(printf '"%s",' "${nvim_tools[@]}")"
nvim_tools_lua="{${nvim_tools_lua%,}}"
if nvim --clean --headless -u NONE -i NONE \
  '+lua local root=vim.fn.stdpath("config"); local files=vim.fn.glob(root.."/**/*.lua",false,true); if #files==0 then vim.api.nvim_err_writeln("no Lua files found"); vim.cmd.cquit() end; for _,f in ipairs(files) do local chunk,err=loadfile(f); if not chunk then vim.api.nvim_err_writeln(f..": "..tostring(err)); vim.cmd.cquit() end end' \
  "+lua for _,x in ipairs($nvim_tools_lua) do if vim.fn.executable(x)~=1 then vim.api.nvim_err_writeln('missing executable: '..x); vim.cmd.cquit() end end" \
  +qa >/dev/null 2>&1
then
  pass "Neovim Lua and dependencies are valid"
else
  fail "Neovim Lua or dependency validation failed"
fi

summary="$checks checks"
((failures == 0 && looks == 0)) && summary="$summary, all good"
((failures > 0)) && summary="$summary, $failures failed (the \"fail\" lines above)"
((looks > 0)) && summary="$summary, $looks to look at (the \"look\" lines above)"
printf '\n%s\n' "$summary"
# Exit code: the number of real failures. A "look" does not fail the run;
# the machine works, it just has housekeeping waiting.
exit "$failures"
