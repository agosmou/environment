# Native macOS applications installed by Homebrew. The macOS equivalent of
# platform/fedora/packages: only things that cannot or should not come from
# Home Manager. Applied by platform/darwin/bootstrap.sh; checked by
# scripts/doctor, which also reports anything brew has that is not listed
# here.
#
# To add: add a line, run `just bootstrap <target>`.
# To remove: delete the line, then `brew uninstall --cask <name>` yourself.

# Terminal. nixpkgs has no Ghostty build for macOS; the cask is the signed
# .app from upstream. Its config still comes from home/terminal/ghostty.nix.
cask "ghostty"

# Music, chat, notes. Same set as home/desktop/apps.nix on Linux.
cask "spotify"
cask "slack"
cask "discord"
cask "obsidian"

# AI desktop apps, all official dmgs. On Fedora, ChatGPT/Codex comes from
# OpenAI's rpm; Claude has no Fedora build yet.
cask "chatgpt"
cask "codex"
cask "claude"

# Containers. Mac only: Fedora ships podman, which does the same job natively.
cask "docker-desktop"

# VPN. Official dmg; on Fedora it is Mullvad's own dnf repository.
cask "mullvad-vpn"

# Tailscale: the "Standalone" variant (a .pkg from pkgs.tailscale.com), which
# Tailscale recommends over the App Store one; menu-bar app plus the
# `tailscale` command. https://tailscale.com/kb/1065/macos-variants
cask "tailscale-app"

# Remote desktop. nixpkgs marks RustDesk unsupported on Apple Silicon.
# After install, grant its macOS permissions: docs/remote-access.md.
cask "rustdesk"

# Network inspection, matching platform/fedora/packages. nmap needs sudo for
# LAN discovery and SYN scans, and sudo does not see ~/.nix-profile/bin, so
# it comes from brew. The Wireshark cask is the upstream .app; its ChmodBPF
# helper lets you capture without root, the macOS equivalent of Fedora's
# wireshark group. tcpdump ships with macOS.
brew "nmap"
cask "wireshark-app"
